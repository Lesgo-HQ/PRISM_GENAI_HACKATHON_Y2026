# Enforce LF line endings for all text files.
# This prevents git from rewriting files on Windows checkout (core.autocrlf)
# and stops the "file keeps reverting" problem.
* text=auto eol=lf

# Dart / Flutter source — always LF
*.dart text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.kt   text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Binaries — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.apk  binary
*.aab  binary
*.so   binary
*.jar  binary
*.keystore binary

